# Source only this project's trusted configuration from a POSIX shell.
HD485_DEVICE=/dev/ttyS3
HD485_SOCKET=/run/hd485.sock
HD485_ROOT=/userdata/hd-rs485/files
HD485_BAUD=230400
HD485_DE=gpio
HD485_GPIO=35
HD485_MODE=idle
# Shell execution is opt-in via --allow-shell, never implicitly enabled here.
